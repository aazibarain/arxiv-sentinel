GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Added automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Required by Vercel Cron; generate a long random value and keep it secret.
CRON_SECRET=

# Optional source identification and ingestion tuning.
OPENALEX_MAILTO=
INGESTION_LOOKBACK_DAYS=7
INGESTION_LIMIT_PER_SOURCE=30
DIGEST_MAX_PAPERS=15
CORPUS_MAX_PAPERS=1000
RELEVANCE_THRESHOLD=0.48
LEXICAL_RELEVANCE_THRESHOLD=0.34

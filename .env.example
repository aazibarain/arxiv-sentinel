# Required in Phase 3 for grounded summaries and Q&A.
GEMINI_API_KEY=

# Strongly recommended by OpenAlex for API identification.
OPENALEX_MAILTO=your_email@example.com

# Phase 1 and 2 defaults
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.50
SOURCE_REQUEST_TIMEOUT_SECONDS=30
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=arxiv_sentinel_papers
NOVELTY_INCREMENTAL_THRESHOLD=0.75
NOVELTY_DUPLICATE_THRESHOLD=0.92
NOVELTY_TOP_K=5
